# yt-x theme - Generated by matugen. DO NOT EDIT.
# Sourced automatically via CONFIG_AUTOLOADED_EXTENSIONS="themes/matugen.theme"

__yt_x_matugen_esc() {
  h="$(printf '%s' "$1" | sed 's/^#//')"
  printf '\033[38;2;%d;%d;%dm' \
    "$(printf '%d' "0x${h%????}")" \
    "$(printf '%d' "0x$(printf '%s' "$h" | cut -c3-4)")" \
    "$(printf '%d' "0x${h#????}")"
}

THEME_FZF_ICON_COLOR_PRIMARY="$(__yt_x_matugen_esc '{{colors.primary.default.hex}}')"
THEME_FZF_ICON_COLOR_SECONDARY="$(__yt_x_matugen_esc '{{colors.on_surface_variant.default.hex}}')"
THEME_FZF_ICON_COLOR_ACCENT="$(__yt_x_matugen_esc '{{colors.tertiary.default.hex}}')"
THEME_FZF_ICON_COLOR_ERROR="$(__yt_x_matugen_esc '{{colors.error.default.hex}}')"
THEME_FZF_PREVIEW_TITLE="$(__yt_x_matugen_esc '{{colors.on_surface.default.hex}}')"
THEME_FZF_PREVIEW_KEY="$(__yt_x_matugen_esc '{{colors.primary.default.hex}}')"
THEME_FZF_PREVIEW_VALUE="$(__yt_x_matugen_esc '{{colors.on_surface_variant.default.hex}}')"
THEME_FZF_PREVIEW_DIVIDER="$(__yt_x_matugen_esc '{{colors.outline_variant.default.hex}}')"
THEME_PLAYER_START="$(__yt_x_matugen_esc '{{colors.primary.default.hex}}')"

CONFIG_FZF_OPTS="
  --ansi
  --border
  --scheme=history
  --style=full
  --color=bg+:{{colors.surface_container_highest.default.hex}}
  --color=bg:{{colors.surface.default.hex}}
  --color=border:{{colors.outline.default.hex}}
  --color=fg:{{colors.on_surface.default.hex}}
  --color=gutter:{{colors.surface.default.hex}}
  --color=header:{{colors.primary.default.hex}}
  --color=hl+:{{colors.primary.default.hex}}
  --color=hl:{{colors.primary.default.hex}}
  --color=info:{{colors.outline.default.hex}}
  --color=marker:{{colors.tertiary.default.hex}}
  --color=pointer:{{colors.primary.default.hex}}
  --color=prompt:{{colors.primary.default.hex}}
  --color=query:{{colors.on_surface.default.hex}}:regular
  --color=scrollbar:{{colors.outline_variant.default.hex}}
  --color=separator:{{colors.secondary.default.hex}}
  --color=spinner:{{colors.tertiary.default.hex}}
  --border=rounded
  --border-label=''
  --prompt=' >'
  --marker=' >'
  --pointer='◆'
  --layout=reverse
  --cycle
  --ghost='こんにちは...'
  --height=100%
  --bind=ctrl-/:toggle-preview,ctrl-space:toggle-wrap+toggle-preview-wrap
  --no-margin
  +m
  -i
  --exact
  --tabstop=1
  --preview-window=border-rounded,left,35%,wrap
  --wrap"

unset -f __yt_x_matugen_esc
