* {
    accent: {{colors.primary.default.hex}};
    foreground: {{colors.on_surface.default.hex}};
    background: {{colors.surface.default.hex}};
    surface: {{colors.surface_container_lowest.default.hex}};
    onsurface: {{colors.on_surface_variant.default.hex}};
    onprimary: {{colors.on_primary.default.hex}};
    error: {{colors.error.default.hex}};

    accentl: {{colors.primary.light.hex}};
    foregroundl: {{colors.on_surface.light.hex}};
    backgroundl: {{colors.surface.light.hex}};
    surfacel: {{colors.surface_container_lowest.light.hex}};
    onsurfacel: {{colors.on_surface_variant.light.hex}};
    onprimaryl: {{colors.on_primary.light.hex}};
    errorl: {{colors.error.light.hex}};
}
