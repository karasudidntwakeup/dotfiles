configuration {
    kb-row-up: "Up,Control+p,k";
    kb-row-down: "Down,Control+n,j";
    kb-row-left: "Control+Page_Up,h";
    kb-row-right: "Control+Page_Down,l";
}

@import "colors.rasi"
@import "mode.rasi"

* {
    background-color: @window-bg;
    text-color: @panel-text;
}

window {
    width: 680px;
    height: 760px;
    anchor: center;
    location: center;
    background-color: @window-bg;
    border: 5;
    border-radius: 20px;
    padding: 18px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @mode-pill;
    padding: 8px 14px;
    border-radius: 20px;
    margin: 0px 0px 12px 0px;
}

prompt {
    font: "JetBrainsMono Nerd Font Bold 11";
    text-color: @panel-accent;
}

entry {
    text-color: @panel-text;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 0px;
}

listview {
    layout: vertical;
    columns: 4;
    lines: 3;
    fixed-columns: true;
    fixed-height: true;
    spacing: 14px;
    scrollbar: true;
    scrollbar-width: 6px;
    cycle: false;
}

element {
    orientation: vertical;
    padding: 4px;
    border: 10px;
    border-color: transparent;
    border-radius: 20px;
    children: [element-icon, element-text];
}

element selected {
    border-color: @panel-accent;
}

element-icon {
    size: 148px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

element-text {
    font: "JetBrainsMono Nerd Font 10";
    text-color: inherit;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    margin: 6px 4px 2px 4px;
}

scrollbar {
    handle-width: 6px;
    handle-color: @panel-accent;
    handle-rounded-corners: true;
}
