{
  "niri/workspaces": {
    "format": "{index}",
    "format-icons": {
    }

	},
  "niri/window": {
        "format": "{title}",
        "icon": false,
        "icon-size": 18
    },

	"clock": {
    "format": "󰥔  {:%I:%M %p}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
        "format": {
            "months": "<span color='#ffead3'><b>{}</b></span>",
            "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
            "today": "<span color='#ffcc66'><b><u>{}</u></b></span>"
        }
    },
    "on-click": "waybar-ycal --next-month",
    "on-click-right": "waybar-ycal --prev-month"
},


	"battery": {
		"states": {
			"good": 95,
		//	"warning": 30,
		//	"critical": 20
		},
		"format": "{icon}  {capacity}",
		//"format-charging": "   {capacity}",
        //"format-plugged": "    {capacity}",
        "format-charging": "󰋠 󰛞 󰋑 󰋑  {capacity}",
		"format-plugged": "󰋠 󰛞 󰋑 󰋑  {capacity}",
		"format-alt": "{time}   {icon}",
        "format-icons": ["󱢠 󱢠 󱢠 ", "󱢠 󱢠 󰛞 ", "󱢠 󱢠 󰛞 ", "󱢠 󱢠 󰋑 ", "󱢠 󰛞 󰋑 ", "󱢠 󰛞 󰋑 ", "󱢠 󰋑 󰋑 ", "󰛞 󰋑 󰋑 ", "󰛞 󰋑 󰋑 ", "󰋑 󰋑 󰋑 "]
		//"format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
		//"format-icons": [" ", " ", " ", " ", " "]
	},

	"network": { 
      "format": "󰖩   {essid}",
		"format-ethernet": "{ipaddr}/{cidr}",
		"format-linked": "{ifname} (No IP)",
		"format-disconnected": "󰖪  ",
        "tooltip-format":"Network: <big><b>{essid}</b></big>\nSignal strength: <b>{signaldBm}dBm ({bandwidthDownBytes})</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>"	
    },

"custom/prayer": {
  "exec": "~/.config/waybar/scripts/prayer.sh",
  "interval": 80 
},
  "custom/memory": {
  "exec": "~/.config/waybar/scripts/memory.sh",
  "interval": 5
},
"custom/kblayout": {
  "exec": "~/.config/waybar/scripts/kblayout.sh",
  "interval": 1,
  "return-type": "text"
},
"pulseaudio": {
  "format": "{icon}  {volume}%",
  "format-muted": "󰝟 MUTE",
  "format-icons": {
    "default": ["󰕿", "󰖀", "󰕾"]
  },
  "scroll-step": 5,
  "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
},
"custom/weather": {
  "exec": "~/.config/waybar/scripts/weather.sh",
  "interval": 1740,
  "tooltip": true
},
"custom/spacer": {
    "format": " ",
    "tooltip": false
},
}


