{
    "layer": "top",
    "position": "bottom",
    "width": 500,
    "fixed-center": true,

    "margin": "0 0 10 0",

    "include": [
        "~/.config/waybar/modules.jsonc"
    ],

    "modules-left": [
        "niri/workspaces",
        "custom/weather",
        "custom/prayer"
    ],


    "modules-right": [
        "custom/kblayout",
        "pulseaudio",
        "custom/memory",
        "network",
        "battery",
        "clock"
    ]
}
