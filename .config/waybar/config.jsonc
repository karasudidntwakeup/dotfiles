{
    "layer": "top",
    "position": "bottom",
    "height": 40,
    "width": 3,
    "fixed-center": true,

    "margin": "8 0 0 0",

    "include": [
        "~/.config/waybar/modules.jsonc"
    ],

    "modules-left": [
        "niri/workspaces"
    ],

    "modules-center": [
        "custom/weather",
        "custom/prayer"
    ],

    "modules-right": [
        "custom/kblayout",
        "pulseaudio",
        "custom/memory",
        "network",
        "battery",
        "clock"
    ]
}
