{
    "layer": "top",
    "position": "top",
    "height": 40,
    "fixed-center": true,
    "margin": "10 500 0 500",

    "include": [
        "~/.config/waybar/modules.jsonc"
    ],

    "modules-left": [
        "niri/workspaces"
    ],

    "modules-center": [
        "custom/weather",
        "custom/prayer"
    ],

    "modules-right": [
        "custom/kblayout",
        "pulseaudio",
        "custom/memory",
        "network",
        "battery",
        "clock"
    ]
}
