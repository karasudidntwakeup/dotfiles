# Retro Phosphor Green - grille + green tint + glow, full P1 terminal fantasy
# Usage: custom_shaders retro-phosphor-green
startgroup
    var float WARP = 0.25
    var float SCAN = 0.55
    var float GRILLE = 0.28
    var float VIGNETTE = 0.35
    var float4 TINT = float4(0.2, 1.0, 0.33, 1)
    shaders crt-grille bloom
endgroup
