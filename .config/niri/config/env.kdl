prefer-no-csd

environment {
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_QPA_PLATFORM "wayland"
    XDG_CURRENT_DESKTOP "niri"
    DISPLAY ":0"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    GDK_BACKEND "wayland,x11"
    MOZ_ENABLE_WAYLAND "1"
    MOZ_DBUS_REMOTE "1"
}

cursor {
    xcursor-theme "MacTahoe-dark"
    xcursor-size 22
    hide-after-inactive-ms 500
    hide-when-typing
}

xwayland-satellite {
  off
    path "xwayland-satellite"
}

clipboard {
    disable-primary
}

gestures {

    dnd-edge-view-scroll {
        trigger-width 30
        delay-ms 100
        max-speed 1500
    }
        dnd-edge-workspace-switch {
        trigger-height 50
        delay-ms 100
        max-speed 1500
    }

    hot-corners {
        off
    }
}
