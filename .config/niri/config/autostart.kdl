spawn-at-startup "bash" "-c" "python3 /home/karasu/.config/quickshell/scripts/wa-notify.py"
spawn-at-startup "bash" "-c" "/home/karasu/.config/quickshell/scripts/wa-follow-watch.sh"
spawn-at-startup "bash" "-c" "pkill -x qs 2>/dev/null; pkill -x quickshell 2>/dev/null; sleep 0.5; exec qs -d --path /home/karasu/.config/quickshell/shell.qml"
spawn-at-startup "bash" "-c" "for p in $(pgrep -f 'python3 -u bombaclip\\.py'); do [ \"$p\" != \"$$\" ] && kill \"$p\" 2>/dev/null; done; sleep 0.5; cd /home/karasu/github/bombaclip && exec python3 -u bombaclip.py --token \"$(cat ~/.bombaclip_token)\" >> /tmp/bombaclip.log 2>&1"
