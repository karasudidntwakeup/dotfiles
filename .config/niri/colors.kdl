overview {
    backdrop-color "#13111e"
}

layout {
    border {
        active-color "#8bbec7"
        inactive-color "#e0def4"
        urgent-color "#eb6f92"
    }
    focus-ring {
        active-color "#8bbec7"
        inactive-color "#e0def4"
        urgent-color "#eb6f92"
    }
    shadow {
        color "#000000"
    }
}

recent-windows {
    highlight {
        active-color "#8bbec7"
        urgent-color "#eb6f92"
    }
}
