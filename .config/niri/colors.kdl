}

layout {
    border {
        active-color "#cddbf9"
        inactive-color "#c5cbd6"
        urgent-color "#ebb9b9"
    }
    focus-ring {
        active-color "#cddbf9"
        inactive-color "#c5cbd6"
        urgent-color "#ebb9b9"
    }
