overview {
    backdrop-color "#181926"
}

layout {
    border {
        active-color "#8aadf4"
        inactive-color "#a5adcb"
        urgent-color "#ed8796"
    }
    focus-ring {
        active-color "#8aadf4"
        inactive-color "#a5adcb"
        urgent-color "#ed8796"
    }
    shadow {
        color "#000000"
    }
}

recent-windows {
