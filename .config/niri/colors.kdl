overview {
    backdrop-color "#11140f"
}

layout {
    border {
        active-color "#0e3406"
        inactive-color "#000000"
        urgent-color "#600004"
    }
    focus-ring {
        active-color "#0e3406"
        inactive-color "#000000"
        urgent-color "#600004"
    }
    shadow {
        color "#000000"
    }
}

recent-windows {
    highlight {
        active-color "#0e3406"
        urgent-color "#600004"
    }
}
