overview {
    backdrop-color "#ffffff"
}

layout {
    border {
        active-color "#7a4f80"
        inactive-color "#4d444c"
        urgent-color "#ba1a1a"
    }
    focus-ring {
        active-color "#7a4f80"
        inactive-color "#4d444c"
        urgent-color "#ba1a1a"
    }
    shadow {
        color "#000000"
    }
}

recent-windows {
    highlight {
        active-color "#7a4f80"
        urgent-color "#ba1a1a"
    }
}
