overview {
    backdrop-color "#ffffff"
}

layout {
    border {
        active-color "#8f4a4d"
        inactive-color "#524343"
        urgent-color "#ba1a1a"
    }
    focus-ring {
        active-color "#8f4a4d"
        inactive-color "#524343"
        urgent-color "#ba1a1a"
    }
    shadow {
        color "#000000"
    }
}

recent-windows {
    highlight {
        active-color "#8f4a4d"
        urgent-color "#ba1a1a"
    }
}
