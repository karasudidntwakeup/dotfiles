// No solid overview backdrop — transparent so the wallpaper stays visible.
overview {
    backdrop-color "transparent"
}

layout {
    border {
        active-color "#7797b7"
        inactive-color "#c7cdd8"
        urgent-color "#d57780"
    }
    focus-ring {
        active-color "#7797b7"
        inactive-color "#c7cdd8"
        urgent-color "#d57780"
    }
    shadow {
        color "#000000"
    }
}

recent-windows {
    highlight {
        active-color "#7797b7"
        urgent-color "#d57780"
    }
}
