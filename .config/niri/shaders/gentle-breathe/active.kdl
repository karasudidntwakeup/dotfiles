// gentle-breathe — a soft, breathing window transition
// Comfortable to human eyes: slow reveal, subtle scale, warm tint, ease-out curve
animations {
    window-open {
        duration-ms 650
        curve "ease-out-cubic"
        custom-shader r#"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                vec2 uv = coords_geo.xy;
                vec2 center = vec2(0.5, 0.5);
                float scale = mix(0.96, 1.0, p);
                vec2 scaled_uv = (uv - center) / scale + center;
                vec3 tc = niri_geo_to_tex * vec3(scaled_uv, 1.0);
                vec4 win = texture2D(niri_tex, tc.st);
                float alpha = smoothstep(0.0, 0.85, p);
                vec3 warm = vec3(1.0, 0.97, 0.94);
                vec3 color = mix(win.rgb, win.rgb * warm, p * 0.08);
                return vec4(color, win.a * alpha);
            }
        "#
    }
    window-close {
        duration-ms 650
        curve "ease-out-cubic"
        custom-shader r#"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = 1.0 - niri_clamped_progress;
                vec2 uv = coords_geo.xy;
                vec2 center = vec2(0.5, 0.5);
                float scale = mix(1.0, 0.96, p);
                vec2 scaled_uv = (uv - center) / scale + center;
                vec3 tc = niri_geo_to_tex * vec3(scaled_uv, 1.0);
                vec4 win = texture2D(niri_tex, tc.st);
                float alpha = smoothstep(1.0, 0.15, p);
                vec3 warm = vec3(1.0, 0.97, 0.94);
                vec3 color = mix(win.rgb * warm, win.rgb, p * 0.08);
                return vec4(color, win.a * alpha);
            }
        "#
    }
}
