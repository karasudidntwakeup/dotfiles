prefer-no-csd
environment {
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_QPA_PLATFORM "wayland"
    XDG_CURRENT_DESKTOP "niri"
    DISPLAY ":0"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    GDK_BACKEND "wayland,x11"
    MOZ_ENABLE_WAYLAND "1"
    MOZ_DBUS_REMOTE "1"
}
cursor {
    xcursor-theme "MacTahoe-dark"
    xcursor-size 22
    hide-after-inactive-ms 500
    hide-when-typing
}

xwayland-satellite {
  off
    path "xwayland-satellite"
}
clipboard {
    disable-primary
}


input {
      focus-follows-mouse
    keyboard {
        repeat-delay 200
        repeat-rate 40
        xkb {
            layout "us,ara"
            options "grp:ctrl_space_toggle"
        }
        numlock
    }

    touchpad {
       // natural-scroll
       accel-speed 0.25
       click-method "clickfinger"
       tap
    }
    mouse {
    }
    trackpoint {
    }
}

gestures {

    dnd-edge-view-scroll {
        trigger-width 30
        delay-ms 100
        max-speed 1500
    }
        dnd-edge-workspace-switch {
        trigger-height 50
        delay-ms 100
        max-speed 1500
    }

    hot-corners {
        off
    }
}

output "eDP-1" {
    mode "1920x1080@60"
    scale 1

}
 overview {
  workspace-shadow {
        on
        color "#000000aa"
        softness 40
        spread 8
        offset x=0 y=10
    }
  zoom 0.40
}
layout {
  gaps 25
    struts {
        bottom 10
    }
      border {
        off
        width 2
        active-color "#505050"
        inactive-color "#000000"
        urgent-color "#9b0000"
    }

    center-focused-column "on-overflow"
    always-center-single-column 
        preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
       preset-window-heights {
        proportion 0.43333
        proportion 0.5
        proportion 0.66667
    }


      
    focus-ring {
        on
        width 2
        active-color "#7fc8ff"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    default-column-width { proportion 0.50; }

    shadow {
        off
    }
}

// Startup Applications
spawn-sh-at-startup "qs"
spawn-sh-at-startup "pipewire"
spawn-sh-at-startup "pipewire-pulse"
spawn-sh-at-startup "wireplumber"
spawn-at-startup "swaync"
spawn-at-startup "awww-daemon"
spawn-at-startup "sh" "-c" "wl-paste --type text --watch cliphist store"
spawn-at-startup "sh" "-c" "wl-paste --type image --watch cliphist store"
hotkey-overlay {
     skip-at-startup
}
screenshot-path null
 
animations {

    window-open {
        // Windows open with a slow, gentle fade so the eye eases in.
        duration-ms 500
        curve "ease-out-expo"
    }

    window-close {
        // Windows close with a calm, extended fade.
        duration-ms 500
        curve "ease-out-expo"
    }

    // Under-damped springs glide into place with a soft, eye-pleasing drift.
    window-movement {
        spring damping-ratio=0.85 stiffness=220 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=0.85 stiffness=220 epsilon=0.0001
    }

    // Spaces slide horizontally; slower and softer on the eye.
    horizontal-view-movement {
        spring damping-ratio=0.9 stiffness=220 epsilon=0.0001
    }

    workspace-switch {
        spring damping-ratio=0.85 stiffness=180 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.7 stiffness=80 epsilon=0.001
    }

    exit-confirmation-open-close {
        spring damping-ratio=0.7 stiffness=80 epsilon=0.01
    }

    screenshot-ui-open {
        duration-ms 300
        curve "ease-out-expo"
    }

    // Mission Control: gentle springy zoom into the overview.
    overview-open-close {
        spring damping-ratio=0.75 stiffness=280 epsilon=0.0001
    }

    recent-windows-close {
        spring damping-ratio=0.9 stiffness=350 epsilon=0.001
    }
}
window-rule {
    match app-id=r#"^rofi$"#
    open-floating false
    open-focused true
}

layer-rule {
    match namespace="quickshell"
    match layer="top"
}
window-rule {
    match app-id=r#".*"#
    geometry-corner-radius 15
    clip-to-geometry true
    shadow {
        on
        softness 60
        spread 8
        offset x=9 y=5
        color "#00000070"
    }
}

window-rule {
    match app-id="librewolf"
    default-column-width { proportion 0.70;}
}

window-rule {
    match app-id="pcmanfm"
}



window-rule {
    match app-id=r#"telegram"#
    default-column-width { proportion 0.3;}
  }
window-rule {
    match app-id=r#"mpv"#
    default-column-width { proportion 0.95;}
  }
window-rule {
    match app-id=r#"sxiv"#
    default-column-width { proportion 0.7; }
}

// Rules for xdg-desktop-portal-gtk
window-rule {
    match app-id=r#"xdg-desktop-portal-gtk"#
    open-floating true
    default-floating-position x=0 y=0
    min-width 400
    min-height 600
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+space { spawn "rofi" "-show" "run"; }
    Mod+V { spawn "~/.config/rofi/cliphist/launcher.sh" "||" "pkill" "rofi"; }
    Mod+g { spawn "~/.config/rofi/wallpaper-changer/launcher.sh" "||" "pkill" "rofi"; }
    Mod+Shift+S hotkey-overlay-title="Pick Window Shader" { spawn "~/.config/niri/shaders/pick.sh"; }
    Mod+Return hotkey-overlay-title="Open a Terminal: foot" { spawn "foot"; }
    Super+C hotkey-overlay-title="Open Browser: LibreWolf" { spawn "librewolf"; }
    Super+Shift+Q hotkey-overlay-title="Lock the Screen: hyprlock" { spawn "hyprlock"; }
    /////////
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86MonBrightnessUp     allow-when-locked=true { spawn "light" "-A" "10"; }
    XF86MonBrightnessDown     allow-when-locked=true { spawn "light" "-U" "10"; }
    Mod+Shift+N { spawn "~/.config/hypr/scripts/monochrome_wallpaper.sh"; }
    Mod+0 repeat=false { toggle-overview; }
    Mod+W repeat=true { toggle-overview; }
    Mod+Shift+o repeat=false { toggle-overview; }
    Mod+X repeat=false { close-window; }
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Shift+Return { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Shift+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }
    Mod+Shift+L     { move-column-right; }
    Mod+J     { focus-window-or-workspace-down; }
    Mod+K     { focus-window-or-workspace-up; }
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }
    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }
    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+j { move-column-to-workspace 2; }
    Mod+Shift+k { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+S { maximize-column; }
    Mod+F { fullscreen-window; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+b { center-column; }
    Mod+Ctrl+C { center-visible-columns; }
    Mod+Minus { set-column-width "-5%"; }
    Mod+Equal { set-column-width "+5%"; }
    Mod+Shift+Minus { set-window-height "-5%"; }
    Mod+Shift+Equal { set-window-height "+5%"; }
    Mod+N       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Print { screenshot; }
    Mod+Escape { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+P { power-off-monitors; }
}
recent-windows {
    // off
    debounce-ms 70
    open-delay-ms 0
    highlight {
        urgent-color "#999999ff"
        active-color "#000000"
        padding 20
        corner-radius 20
    }

    previews {
        max-height 500
        max-scale 0.4
    }

    binds {
        Alt+Tab         { next-window; }
        Alt+Shift+Tab   { previous-window; }
        Alt+grave       { next-window     filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
        Mod+Tab         { next-window; }
        Mod+Shift+Tab   { previous-window; }
        Mod+grave       { next-window     filter="app-id"; }
        Mod+Shift+grave { previous-window filter="app-id"; }
    }
}

blur {
  off
}

include "colors.kdl"
include "shaders/active.kdl"
