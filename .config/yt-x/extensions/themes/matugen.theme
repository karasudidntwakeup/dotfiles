# yt-x theme - Generated by matugen. DO NOT EDIT.
# Sourced automatically via CONFIG_AUTOLOADED_EXTENSIONS="themes/matugen.theme"

__yt_x_matugen_esc() {
  h="$(printf '%s' "$1" | sed 's/^#//')"
  printf '\033[38;2;%d;%d;%dm' \
    "$(printf '%d' "0x${h%????}")" \
    "$(printf '%d' "0x$(printf '%s' "$h" | cut -c3-4)")" \
    "$(printf '%d' "0x${h#????}")"
}

THEME_FZF_ICON_COLOR_PRIMARY="$(__yt_x_matugen_esc '#cefdbc')"
THEME_FZF_ICON_COLOR_SECONDARY="$(__yt_x_matugen_esc '#ffffff')"
THEME_FZF_ICON_COLOR_ACCENT="$(__yt_x_matugen_esc '#c9f9fc')"
THEME_FZF_ICON_COLOR_ERROR="$(__yt_x_matugen_esc '#ffece9')"
THEME_FZF_PREVIEW_TITLE="$(__yt_x_matugen_esc '#ffffff')"
THEME_FZF_PREVIEW_KEY="$(__yt_x_matugen_esc '#cefdbc')"
THEME_FZF_PREVIEW_VALUE="$(__yt_x_matugen_esc '#ffffff')"
THEME_FZF_PREVIEW_DIVIDER="$(__yt_x_matugen_esc '#bfc5b8')"
THEME_PLAYER_START="$(__yt_x_matugen_esc '#cefdbc')"

CONFIG_FZF_OPTS="
  --ansi
  --border
  --scheme=history
  --style=full
  --color=bg+:#444841
  --color=bg:#11140f
  --color=border:#ecf2e5
  --color=fg:#ffffff
  --color=gutter:#11140f
  --color=header:#cefdbc
  --color=hl+:#cefdbc
  --color=hl:#cefdbc
  --color=info:#ecf2e5
  --color=marker:#c9f9fc
  --color=pointer:#cefdbc
  --color=prompt:#cefdbc
  --color=query:#ffffff:regular
  --color=scrollbar:#bfc5b8
  --color=separator:#e4f5da
  --color=spinner:#c9f9fc
  --border=rounded
  --border-label=''
  --prompt=' >'
  --marker=' >'
  --pointer='◆'
  --layout=reverse
  --cycle
  --ghost='こんにちは...'
  --height=100%
  --bind=ctrl-/:toggle-preview,ctrl-space:toggle-wrap+toggle-preview-wrap
  --no-margin
  +m
  -i
  --exact
  --tabstop=1
  --preview-window=border-rounded,left,35%,wrap
  --wrap"

unset -f __yt_x_matugen_esc
